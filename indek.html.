<script>
/*
 * EDIT PRODUK DI SINI:
 * Ubah nama, kategori, harga, hargaCoret, foto, warna, dan ukuran sesuai stok toko.
 * Foto menggunakan URL gambar; ganti dengan URL foto produk ALFAKIDS sendiri untuk hasil terbaik.
 */
const PRODUCTS = [
  {id:"kaos", name:"Kaos Anak Basic", category:"Kaos", price:35000, oldPrice:45000, badge:"BEST SELLER", image:"https://images.unsplash.com/photo-1503919005314-30d93d07d823?auto=format&fit=crop&w=700&q=80", colors:[{name:"Putih",hex:"#f4f1e9"},{name:"Hitam",hex:"#222222"},{name:"Merah",hex:"#d71920"},{name:"Navy",hex:"#202c45"}], sizes:["2","4","6","8","10","12"], sizeLabel:"Ukuran" },
  {id:"kemeja-pendek", name:"Kemeja Anak Lengan Pendek", category:"Kemeja", price:59000, oldPrice:69000, badge:"NEW", image:"https://images.unsplash.com/photo-1519238263530-99bdd11df2ea?auto=format&fit=crop&w=700&q=80", colors:[{name:"Putih",hex:"#f5f2eb"},{name:"Navy",hex:"#202c45"},{name:"Hitam",hex:"#222222"},{name:"Khaki",hex:"#b9a17c"}], sizes:["2","4","6","8","10","12"], sizeLabel:"Ukuran" },
  {id:"kemeja-panjang", name:"Kemeja Anak Lengan Panjang", category:"Kemeja", price:65000, oldPrice:75000, badge:"", image:"https://images.unsplash.com/photo-1519238263530-99bdd11df2ea?auto=format&fit=crop&w=700&q=80", colors:[{name:"Putih",hex:"#f5f2eb"},{name:"Navy",hex:"#202c45"},{name:"Hitam",hex:"#222222"},{name:"Sage",hex:"#9da995"}], sizes:["2","4","6","8","10","12"], sizeLabel:"Ukuran" },
  {id:"setelan", name:"Setelan Anak Casual", category:"Setelan", price:79000, oldPrice:95000, badge:"FAVORIT", image:"https://images.unsplash.com/photo-1519238263530-99bdd11df2ea?auto=format&fit=crop&w=700&q=80", colors:[{name:"Cream",hex:"#e9dfcf"},{name:"Navy",hex:"#202c45"},{name:"Maroon",hex:"#70232f"},{name:"Hitam",hex:"#222222"}], sizes:["2","4","6","8","10","12"], sizeLabel:"Ukuran" },
  {id:"atasan", name:"Atasan Anak Everyday", category:"Atasan", price:39000, oldPrice:49000, badge:"", image:"https://images.unsplash.com/photo-1503919005314-30d93d07d823?auto=format&fit=crop&w=700&q=80", colors:[{name:"Putih",hex:"#f5f2eb"},{name:"Merah",hex:"#d71920"},{name:"Hitam",hex:"#222222"},{name:"Mocca",hex:"#9a7660"}], sizes:["2","4","6","8","10","12"], sizeLabel:"Ukuran" },
  {id:"chinos-pendek", name:"Chinos Pendek Anak", category:"Chinos", price:49000, oldPrice:59000, badge:"BEST SELLER", image:"https://images.unsplash.com/photo-1519238263530-99bdd11df2ea?auto=format&fit=crop&w=700&q=80", colors:[{name:"Cream",hex:"#e9dfcf"},{name:"Hitam",hex:"#222222"},{name:"Abu Tua",hex:"#555555"},{name:"Khaki",hex:"#b9a17c"}], sizes:["2","4","6","8","10","12"], sizeLabel:"Ukuran" },
  {id:"chinos-panjang", name:"Chinos Panjang Anak", category:"Chinos", price:69000, oldPrice:79000, badge:"", image:"https://images.unsplash.com/photo-1519238263530-99bdd11df2ea?auto=format&fit=crop&w=700&q=80", colors:[{name:"Cream",hex:"#e9dfcf"},{name:"Hitam",hex:"#222222"},{name:"Navy",hex:"#202c45"},{name:"Khaki",hex:"#b9a17c"}], sizes:["2","4","6","8","10","12"], sizeLabel:"Ukuran" },
  {id:"cargo-pendek", name:"Cargo Pendek Anak", category:"Cargo", price:55000, oldPrice:65000, badge:"", image:"https://images.unsplash.com/photo-1519238263530-99bdd11df2ea?auto=format&fit=crop&w=700&q=80", colors:[{name:"Army",hex:"#59634a"},{name:"Hitam",hex:"#222222"},{name:"Khaki",hex:"#b9a17c"},{name:"Coksu",hex:"#9a7660"}], sizes:["2","4","6","8","10","12"], sizeLabel:"Ukuran" },
  {id:"cargo-panjang", name:"Cargo Panjang Anak", category:"Cargo", price:75000, oldPrice:89000, badge:"", image:"https://images.unsplash.com/photo-1519238263530-99bdd11df2ea?auto=format&fit=crop&w=700&q=80", colors:[{name:"Army",hex:"#59634a"},{name:"Hitam",hex:"#222222"},{name:"Navy",hex:"#202c45"},{name:"Khaki",hex:"#b9a17c"}], sizes:["2","4","6","8","10","12"], sizeLabel:"Ukuran" }
];

const rupiah = value => new Intl.NumberFormat("id-ID", {style:"currency", currency:"IDR", maximumFractionDigits:0}).format(value);
const cart = [];
const selections = {};
const productGrid = document.getElementById("productGrid");
const searchInput = document.getElementById("searchInput");
const categoryFilter = document.getElementById("categoryFilter");
const sortSelect = document.getElementById("sortSelect");

function selectedValue(product, key) {
  const state = selections[product.id] || (selections[product.id] = {size: product.sizes[0] || "", color: product.colors[0]?.name || ""});
  return state[key];
}
function renderProducts() {
  let items = PRODUCTS.filter(p => {
    const query = searchInput.value.trim().toLowerCase();
    return (categoryFilter.value === "all" || p.category === categoryFilter.value) &&
      (p.name.toLowerCase().includes(query) || p.category.toLowerCase().includes(query));
  });
  if (sortSelect.value === "low") items.sort((a,b) => a.price-b.price);
  if (sortSelect.value === "high") items.sort((a,b) => b.price-a.price);
  if (sortSelect.value === "name") items.sort((a,b) => a.name.localeCompare(b.name, "id"));
  productGrid.innerHTML = "";
  if (!items.length) {
    productGrid.innerHTML = '<div class="empty-state">Produk tidak ditemukan. Coba kata kunci atau kategori lain.</div>';
    return;
  }
  items.forEach(p => {
    const chosenSize = selectedValue(p, "size");
    const chosenColor = selectedValue(p, "color");
    const card = document.createElement("article");
    card.className = "product-card";
    card.innerHTML = `
      <div class="product-photo"><img src="${p.image}" alt="${p.name}" loading="lazy" onerror="this.onerror=null;this.src='https://placehold.co/700x790/f0ece7/272727?text=ALFAKIDS+KIDS+WEAR'">${p.badge ? `<span class="badge">${p.badge}</span>` : ""}</div>
      <div class="product-info">
        <div class="product-type">${p.category} / ALFAKIDS</div>
        <h3>${p.name}</h3>
        <div class="price">${rupiah(p.price)} ${p.oldPrice ? `<small>${rupiah(p.oldPrice)}</small>` : ""}</div>
        ${p.sizes.length ? `<span class="field-label">${p.sizeLabel || "Ukuran"}</span><div class="options size-options">${p.sizes.map(s=>`<button class="option ${s===chosenSize?"selected":""}" data-size="${s}" type="button">${s}</button>`).join("")}</div>` : ""}
        ${p.colors.length ? `<span class="field-label">Warna: <span class="selected-color-name">${chosenColor}</span></span><div class="options color-options">${p.colors.map(c=>`<button class="option ${c.name===chosenColor?"selected":""}" data-color="${c.name}" type="button" title="${c.name}"><span class="color-dot" style="background:${c.hex}"></span>${c.name}</button>`).join("")}</div>` : ""}
        <span class="field-label">Jumlah</span>
        <div class="product-bottom"><div class="qty"><button type="button" data-qty="-1" aria-label="Kurangi">−</button><input type="number" min="1" max="99" value="1" aria-label="Jumlah ${p.name}"><button type="button" data-qty="1" aria-label="Tambah">+</button></div><button type="button" class="btn add-btn">+ KERANJANG</button></div>
      </div>`;
    card.querySelectorAll("[data-size]").forEach(btn=>btn.addEventListener("click",()=>{
      selections[p.id].size=btn.dataset.size;
      card.querySelectorAll("[data-size]").forEach(b=>b.classList.toggle("selected",b===btn));
    }));
    card.querySelectorAll("[data-color]").forEach(btn=>btn.addEventListener("click",()=>{
      selections[p.id].color=btn.dataset.color;
      card.querySelectorAll("[data-color]").forEach(b=>b.classList.toggle("selected",b===btn));
      card.querySelector(".selected-color-name").textContent=btn.dataset.color;
    }));
    const qtyInput=card.querySelector('input[type="number"]');
    card.querySelectorAll("[data-qty]").forEach(btn=>btn.addEventListener("click",()=>qtyInput.value=Math.max(1,Math.min(99,(parseInt(qtyInput.value)||1)+Number(btn.dataset.qty)))));
    qtyInput.addEventListener("change",()=>qtyInput.value=Math.max(1,Math.min(99,parseInt(qtyInput.value)||1)));
    card.querySelector(".add-btn").addEventListener("click",()=>{
      const quantity=Math.max(1,Math.min(99,parseInt(qtyInput.value)||1));
      const state=selections[p.id];
      const existing=cart.find(i=>i.id===p.id&&i.size===state.size&&i.color===state.color);
      if(existing) existing.qty+=quantity;
      else cart.push({id:p.id,name:p.name,price:p.price,size:state.size,color:state.color,qty:quantity});
      renderCart(); showToast(`${p.name} ditambahkan ke keranjang`);
    });
    productGrid.appendChild(card);
  });
}
function renderCart() {
  const count=cart.reduce((sum,item)=>sum+item.qty,0);
  document.getElementById("cartCount").textContent=count;
  document.getElementById("cartItems").innerHTML=cart.length ? cart.map((item,index)=>`
    <div class="cart-row"><div><strong>${item.name}</strong><small>Ukuran: ${item.size||"-"} · Warna: ${item.color||"-"}<br>Jumlah: ${item.qty} × ${rupiah(item.price)}</small><button class="remove-btn" data-remove="${index}">Hapus item</button></div><div class="cart-price">${rupiah(item.qty*item.price)}</div></div>`).join("") : '<div class="empty-state">Keranjangmu masih kosong.<br>Yuk, pilih outfit favorit!</div>';
  document.getElementById("cartTotal").textContent=rupiah(cart.reduce((sum,item)=>sum+item.price*item.qty,0));
  document.getElementById("cartItems").querySelectorAll("[data-remove]").forEach(btn=>btn.addEventListener("click",()=>{cart.splice(Number(btn.dataset.remove),1);renderCart();}));
  document.getElementById("checkoutSummary").innerHTML=cart.length ? `<strong>Ringkasan pesanan</strong><br>${cart.map(i=>`${i.name} (${i.size||"-"}, ${i.color||"-"}) × ${i.qty} — ${rupiah(i.price*i.qty)}`).join("<br>")}<hr><strong>Total produk: ${rupiah(cart.reduce((s,i)=>s+i.price*i.qty,0))}</strong><br><small>Ongkir akan dikonfirmasi oleh penjual.</small>` : "Keranjang masih kosong.";
}
function showToast(message) {
  const toast=document.getElementById("toast");
  toast.textContent=message;toast.classList.add("show");
  clearTimeout(window.toastTimer);window.toastTimer=setTimeout(()=>toast.classList.remove("show"),2400);
}
function openCart() {
  document.getElementById("cartDrawer").classList.add("open");
  document.getElementById("drawerBackdrop").classList.add("open");
  document.getElementById("cartDrawer").setAttribute("aria-hidden","false");
}
function closeCart() {
  document.getElementById("cartDrawer").classList.remove("open");
  document.getElementById("drawerBackdrop").classList.remove("open");
  document.getElementById("cartDrawer").setAttribute("aria-hidden","true");
}
document.getElementById("cartOpen").addEventListener("click",openCart);
document.getElementById("cartClose").addEventListener("click",closeCart);
document.getElementById("drawerBackdrop").addEventListener("click",closeCart);
document.getElementById("checkoutBtn").addEventListener("click",()=>{
  if(!cart.length){showToast("Keranjang masih kosong");return;}
  closeCart();renderCart();document.getElementById("checkoutBackdrop").classList.add("open");
});
document.getElementById("checkoutClose").addEventListener("click",()=>document.getElementById("checkoutBackdrop").classList.remove("open"));
document.getElementById("checkoutBackdrop").addEventListener("click",e=>{if(e.target.id==="checkoutBackdrop")e.currentTarget.classList.remove("open");});
document.getElementById("checkoutForm").addEventListener("submit",e=>{
  e.preventDefault();
  if(!cart.length){showToast("Keranjang masih kosong");return;}
  const data=new FormData(e.currentTarget);
  const total=cart.reduce((s,i)=>s+i.price*i.qty,0);
  const lines=[
    "Halo ALFAKIDS KIDS WEAR, saya ingin memesan:",
    "",
    ...cart.map((i,n)=>`${n+1}. ${i.name}\n   Ukuran: ${i.size||"-"} | Warna: ${i.color||"-"} | Jumlah: ${i.qty}\n   Harga: ${rupiah(i.price*i.qty)}`),
    "",
    `TOTAL PRODUK: ${rupiah(total)}`,
    "",
    `Nama: ${data.get("name")}`,
    `WhatsApp: ${data.get("phone")}`,
    `Alamat: ${data.get("address")}`,
    `Pengiriman: ${data.get("shipping")}`,
    `Pembayaran: ${data.get("payment")}`,
    `Catatan: ${data.get("notes")||"-"}`,
    "",
    "Mohon konfirmasi stok, ongkir, dan total pembayaran. Terima kasih."
  ];
  window.open("https://wa.me/6282127858220?text="+encodeURIComponent(lines.join("\n")),"_blank","noopener");
});
document.getElementById("menuToggle").addEventListener("click",()=>document.getElementById("navLinks").classList.toggle("open"));
document.querySelectorAll("#navLinks a").forEach(a=>a.addEventListener("click",()=>document.getElementById("navLinks").classList.remove("open")));
searchInput.addEventListener("input",renderProducts);
categoryFilter.addEventListener("change",renderProducts);
sortSelect.addEventListener("change",renderProducts);
document.querySelectorAll("[data-category]").forEach(btn=>btn.addEventListener("click",()=>{
  const cat=btn.dataset.category;
  categoryFilter.value=cat==="Kemeja"?"Kemeja":cat;
  if(cat==="Chinos") searchInput.value="";
  else searchInput.value="";
  renderProducts();document.getElementById("produk").scrollIntoView({behavior:"smooth"});
}));
renderProducts();
renderCart();
</script>
